#!/usr/bin/env bash
set -euo pipefail

APP="tui-menu"
VERSION="2.3.0"
AUTHOR="Alfred Njobvu Jr"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tui-menu"
CONFIG_FILE="${TUI_MENU_CONFIG:-$CONFIG_DIR/apps.tsv}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tui-menu"
HISTORY_FILE="$CACHE_DIR/history.tsv"
SORT_STATE="$CACHE_DIR/sort-mode"
MISSING_STATE="$CACHE_DIR/show-missing"
LAST_STATUS="$CACHE_DIR/last-status"
NOTICE_FILE="$CACHE_DIR/notice"

SELF=${BASH_SOURCE[0]}
if [[ $SELF != */* ]]; then
    SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF")
fi
SELF=$(readlink -f "$SELF" 2>/dev/null || printf '%s' "$SELF")
SELF_Q=$(printf '%q' "$SELF")

ORDER=()
declare -A LABEL=() DESC=() CATEGORY=() TAGS=() PACKAGE=() HIDDEN=() SOURCE=()
declare -A TOOL_HOTKEYS=()
TOOL_HOTKEYS[kmscon]=t

add_app() {
    local cmd=$1 label=$2 desc=$3 category=$4 tags=$5 package=$6 source=${7:-built-in}
    if [[ -z ${LABEL["$cmd"]+x} ]]; then
        ORDER+=("$cmd")
    fi
    LABEL["$cmd"]=$label
    DESC["$cmd"]=$desc
    CATEGORY["$cmd"]=$category
    TAGS["$cmd"]=$tags
    PACKAGE["$cmd"]=$package
    SOURCE["$cmd"]=$source
}

add_builtins() {
    add_app yazi       "yazi"       "Modern file manager with image/PDF previews"      File    "file manager,preview"      yazi
    add_app nnn        "nnn"        "Ultra-lightweight minimalist file manager"         File    "file manager,lightweight"  nnn
    add_app mc         "Midnight Commander" "Dual-pane file manager with GPM mouse support" File "file manager,pane"          mc
    add_app spf        "Superfile"  "Vim-like TUI file manager with live preview"      File    "file manager,tui"          superfile
    add_app mpv        "mpv"        "Media player"                                     Media   "video,audio"              mpv
    add_app micro      "micro"      "Modern terminal text editor"                       Editor  "editor,text"               micro
    add_app nano       "nano"       "Simple terminal text editor"                       Editor  "editor,text"               nano
    add_app btop       "btop"       "Resource and process monitor"                      Monitor "system,process,cpu"         btop
    add_app gdu        "gdu"        "Interactive disk usage analyzer"                   Monitor "disk,usage,storage"         gdu
    add_app wiremix    "wiremix"    "PipeWire audio mixer"                              Audio   "audio,pipewire,mixer"      wiremix
    add_app bluetui    "bluetui"    "Interactive Bluetooth manager"                     Network "bluetooth,device"           bluetui
    add_app nmtui      "nmtui"      "NetworkManager Wi-Fi and connection TUI"           Network "network,wifi,connection"    nmtui
    add_app cha        "Chawan"     "Modern terminal web browser"                       Web     "browser,web,pager"         chawan
    add_app w3m        "w3m"        "Text-based web browser and pager"                  Web     "browser,web,pager"         w3m
    add_app dooit      "dooit"      "Interactive todo list manager"                     Util    "todo,tasks,productivity"   dooit
    add_app gophertube "GopherTube" "YouTube search and streaming TUI (mpv + chafa)"    Media   "youtube,streaming,media"   gophertube
    add_app glow       "glow"       "Markdown document reader"                          Util    "markdown,reader,docs"      glow
    add_app cmatrix   "cmatrix"   "Terminal Matrix digital rain screensaver"        Media   "matrix,rain,animation"    cmatrix
    add_app kmscon     "KMSCON"     "DRM console manager with font-size 15 (auto-install)" Tools   "console,tty,font"         kmscon
}

tsv_field() {
    local s=$1 n=$2
    while (( n > 0 )); do
        if [[ $s == *$'\t'* ]]; then
            s=${s#*$'\t'}
        else
            s=""
        fi
        n=$((n - 1))
    done
    printf '%s' "${s%%$'\t'*}"
}

load_config() {
    [[ -f $CONFIG_FILE ]] || return 0
    local line cmd label desc category tags package
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ $line == \#* ]] && continue
        [[ -z ${line//[[:space:]]/} ]] && continue
        cmd=$(tsv_field "$line" 0)
        [[ -n $cmd ]] || continue
        if [[ $cmd == !* ]]; then
            HIDDEN["${cmd#!}"]=1
            continue
        fi
        label=$(tsv_field "$line" 1)
        desc=$(tsv_field "$line" 2)
        category=$(tsv_field "$line" 3)
        tags=$(tsv_field "$line" 4)
        package=$(tsv_field "$line" 5)
        [[ -n $label ]] || label=$cmd
        [[ -n $desc ]] || desc="No description"
        [[ -n $category ]] || category="Other"
        [[ -n $package ]] || package=${cmd%% *}
        add_app "$cmd" "$label" "$desc" "$category" "$tags" "$package" config
    done < "$CONFIG_FILE"

    local -a kept=()
    local item
    for item in "${ORDER[@]}"; do
        if [[ -z ${HIDDEN["$item"]:-} ]]; then
            kept+=("$item")
        fi
    done
    ORDER=("${kept[@]}")
}

ensure_config() {
    if [[ -n ${TUI_MENU_CONFIG:-} ]]; then
        return 0
    fi
    [[ -f $CONFIG_FILE ]] && return 0
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" <<'EOF'
# tui-menu app list (tab-separated)
# cmd<TAB>label<TAB>description<TAB>category<TAB>tags<TAB>package
#
# Override a built-in by reusing its command name.
# Hide a built-in by prefixing the command with ! (for example: !nano).
# Example:
# cha	Chawan	Modern terminal web browser	Web	browser,web	chawan
EOF
}

is_installed() {
    local cmd=${1%% *}
    command -v "$cmd" >/dev/null 2>&1
}

state_read() {
    local file=$1 default=$2 value=""
    if [[ -f $file ]]; then
        IFS= read -r value < "$file" || true
    fi
    if [[ -n $value ]]; then
        printf '%s' "$value"
    else
        printf '%s' "$default"
    fi
}

state_write() {
    mkdir -p "$CACHE_DIR"
    printf '%s\n' "$2" > "$1"
}

notice_write() {
    mkdir -p "$CACHE_DIR"
    printf '%s\t%s\n' "$(date +%s)" "$1" > "$NOTICE_FILE"
}

notice_text() {
    local ts msg ttl=${TUI_MENU_NOTICE_TTL:-8}
    [[ -f $NOTICE_FILE ]] || return 0
    IFS=$'\t' read -r ts msg < "$NOTICE_FILE" || return 0
    [[ $ts =~ ^[0-9]+$ ]] || return 0
    [[ $ttl =~ ^[0-9]+$ ]] || ttl=8
    if (( $(date +%s) - ts <= ttl )); then
        printf '%s' "$msg"
    fi
}

category_color() {
    case ${1,,} in
        file*)  printf '\033[34m' ;;
        edit*)  printf '\033[32m' ;;
        monit*) printf '\033[33m' ;;
        net*)   printf '\033[36m' ;;
        audio*) printf '\033[35m' ;;
        web*)   printf '\033[94m' ;;
        media*) printf '\033[95m' ;;
        util*)  printf '\033[37m' ;;
        sys*)   printf '\033[36m' ;;
        tools*) printf '\033[36m' ;;
        *)      printf '\033[90m' ;;
    esac
}

color_enabled() {
    [[ ${TUI_MENU_COLOR:-auto} == never ]] && return 1
    [[ -n ${NO_COLOR:-} ]] && return 1
    return 0
}

history_sequence() {
    local mode=${1:-frequent}
    local -A count=() last=()
    local ts cmd index=0
    if [[ -f $HISTORY_FILE ]]; then
        while IFS=$'\t' read -r ts cmd; do
            [[ -n ${cmd:-} ]] || continue
            if [[ $mode == recent ]]; then
                [[ $ts =~ ^[0-9]+$ ]] || continue
                if (( ts > ${last["$cmd"]:-0} )); then
                    last["$cmd"]=$ts
                fi
            else
                count["$cmd"]=$(( ${count["$cmd"]:-0} + 1 ))
            fi
        done < "$HISTORY_FILE"
    fi
    for cmd in "${ORDER[@]}"; do
        if [[ $mode == recent ]]; then
            printf '%d\t%d\t%s\n' "${last["$cmd"]:-0}" "$index" "$cmd"
        else
            printf '%d\t%d\t%s\n' "${count["$cmd"]:-0}" "$index" "$cmd"
        fi
        index=$((index + 1))
    done | sort -t$'\t' -k1,1nr -k2,2n | cut -f3-
}

history_stats() {
    local want=$1 ts cmd count=0 last=0
    if [[ -f $HISTORY_FILE ]]; then
        while IFS=$'\t' read -r ts cmd; do
            [[ ${cmd:-} == "$want" ]] || continue
            count=$((count + 1))
            if [[ $ts =~ ^[0-9]+$ ]] && (( ts > last )); then
                last=$ts
            fi
        done < "$HISTORY_FILE"
    fi
    printf '%d\t%d\n' "$count" "$last"
}

build_lines() {
    local mode=$1 show_missing=$2 use_ansi=$3
    local -a sequence=()
    if [[ $mode == frequent || $mode == recent ]]; then
        mapfile -t sequence < <(history_sequence "$mode")
    else
        sequence=("${ORDER[@]}")
    fi

    local cmd installed label desc category tags package padded display color reset
    local display_label hint command_hint
    reset=$'\033[0m'

    for cmd in "${sequence[@]}"; do
        installed=0
        if is_installed "$cmd"; then
            installed=1
        fi
        if [[ $show_missing -eq 0 && $installed -eq 0 ]]; then
            continue
        fi

        label=${LABEL["$cmd"]:-$cmd}
        desc=${DESC["$cmd"]:-}
        category=${CATEGORY["$cmd"]:-Other}
        tags=${TAGS["$cmd"]:-}
        package=${PACKAGE["$cmd"]:-${cmd%% *}}

        display_label=$label
        if [[ ${cmd,,} != ${label,,} ]]; then
            display_label="$label ($cmd)"
        fi
        printf -v padded '%-22s' "$display_label"

        if [[ $use_ansi -eq 1 ]]; then
            color=$(category_color "$category")
            if [[ $installed -eq 0 ]]; then
                color=$'\033[2;90m'
            fi
            display="${color}${padded}${reset} ${desc}"
            [[ -n $category ]] && display+="  ${color}${category}${reset}"
            [[ -n $tags ]] && display+="  ${color}· ${tags}${reset}"
            [[ $installed -eq 0 ]] && display+="  ${color}[missing]${reset}"
        else
            display="${padded} ${desc}"
            [[ -n $category ]] && display+="  ${category}"
            [[ -n $tags ]] && display+="  · ${tags}"
            [[ $installed -eq 0 ]] && display+="  [missing]"
        fi

        printf '%s\t%s\t%s\t%s\n' "$cmd" "$display" "$package" "$installed"
    done
}

header_text() {
    local tmux_hint=""
    if [[ -n ${TMUX:-} ]]; then
        tmux_hint=" · C-o tmux window"
    fi

    printf 'Enter launch · Esc quit · C-y copy · C-r sort · F2 missing · C-/ preview · t tool\n'
    printf 'C-e edit · F1 help · F5 refresh%s\n' "$tmux_hint"
}

footer_text() {
    local sort_mode show_missing sort_label missing_label last_status="" notice=""
    local cmd installed=0 missing=0
    sort_mode=$(state_read "$SORT_STATE" curated)
    show_missing=$(state_read "$MISSING_STATE" 1)
    last_status=$(state_read "$LAST_STATUS" "")
    notice=$(notice_text)

    for cmd in "${ORDER[@]}"; do
        if is_installed "$cmd"; then
            installed=$((installed + 1))
        else
            missing=$((missing + 1))
        fi
    done

    if [[ $sort_mode == frequent ]]; then
        sort_label="most-used"
    elif [[ $sort_mode == recent ]]; then
        sort_label="recent"
    else
        sort_label="curated"
    fi
    if [[ $show_missing == 1 ]]; then
        missing_label="shown"
    else
        missing_label="hidden"
    fi

    printf 'sort: %s · missing: %s · %d installed / %d missing' \
        "$sort_label" "$missing_label" "$installed" "$missing"
    if [[ -n $last_status ]]; then
        printf ' · last: %s' "$last_status"
    fi
    if [[ -n $notice ]]; then
        printf ' · %s' "$notice"
    fi
    printf '\n'
}

record_launch() {
    local cmd=$1
    mkdir -p "$CACHE_DIR"
    if command -v flock >/dev/null 2>&1; then
        {
            flock 9
            printf '%s\t%s\n' "$(date +%s)" "$cmd" >> "$HISTORY_FILE"
        } 9>>"$HISTORY_FILE"
    else
        printf '%s\t%s\n' "$(date +%s)" "$cmd" >> "$HISTORY_FILE"
    fi
}

cmd_internal_list() {
    local mode=${1:-$(state_read "$SORT_STATE" curated)}
    local show_missing
    show_missing=$(state_read "$MISSING_STATE" 1)
    case $mode in
        all)       show_missing=1 ;;
        installed) show_missing=0 ;;
    esac

    local -a lines=()
    local use_ansi=0
    if color_enabled; then
        use_ansi=1
    fi
    mapfile -t lines < <(build_lines "$mode" "$show_missing" "$use_ansi")
    if (( ${#lines[@]} == 0 )); then
        printf 'No apps to show. Press F2 to include missing apps.\n'
        return 0
    fi
    printf '%s\n' "${lines[@]}"
}

cmd_list() {
    local mode=${1:-installed}
    case $mode in
        installed|all) ;;
        *)
            printf 'Usage: %s --list[=installed|all]\n' "$APP" >&2
            return 2
            ;;
    esac

    local cmd installed label desc package status
    for cmd in "${ORDER[@]}"; do
        installed=0
        if is_installed "$cmd"; then
            installed=1
        fi
        if [[ $mode == installed && $installed -eq 0 ]]; then
            continue
        fi
        label=${LABEL["$cmd"]:-$cmd}
        desc=${DESC["$cmd"]:-}
        package=${PACKAGE["$cmd"]:-${cmd%% *}}
        if [[ $installed -eq 1 ]]; then
            status="installed"
        else
            status="missing"
        fi
        printf '%s\t%s\t%s\t%s\n' "$cmd" "$label" "$desc" "$status"
    done
}

cmd_check() {
    local cmd installed package label status version missing=0
    printf '%-14s %-20s %-16s %s\n' "COMMAND" "LABEL" "PACKAGE" "STATUS"
    printf '%-14s %-20s %-16s %s\n' "-------" "-----" "-------" "------"
    for cmd in "${ORDER[@]}"; do
        label=${LABEL["$cmd"]:-$cmd}
        package=${PACKAGE["$cmd"]:-${cmd%% *}}
        if is_installed "$cmd"; then
            version=""
            if command -v pacman >/dev/null 2>&1; then
                version=$(pacman -Q "$package" 2>/dev/null | cut -d' ' -f2- || true)
            fi
            if [[ -n $version ]]; then
                status="installed ($version)"
            else
                status="installed"
            fi
        else
            status="MISSING (yay -S $package)"
            missing=1
        fi
        printf '%-14s %-20s %-16s %s\n' "${cmd%% *}" "$label" "$package" "$status"
    done
    return "$missing"
}

cmd_check_config() {
    local file=$CONFIG_FILE
    printf 'Config: %s\n' "$file"
    if [[ ! -f $file ]]; then
        printf 'Not found; using built-in entries only.\n'
        return 0
    fi

    local -A seen=() hidden_seen=()
    local -a hide_targets=()
    local line cmd stripped tabs lineno=0 entries=0 warnings=0 target
    while IFS= read -r line || [[ -n $line ]]; do
        lineno=$((lineno + 1))
        line=${line%$'\r'}
        [[ $line == \#* ]] && continue
        [[ -z ${line//[[:space:]]/} ]] && continue
        stripped=${line//$'\t'/}
        tabs=$(( ${#line} - ${#stripped} ))
        if (( tabs > 5 )); then
            printf 'line %d: warning: too many fields (%d columns; expected at most 6)\n' \
                "$lineno" "$((tabs + 1))"
            warnings=$((warnings + 1))
        fi

        cmd=$(tsv_field "$line" 0)
        if [[ -z $cmd ]]; then
            printf 'line %d: warning: empty command\n' "$lineno"
            warnings=$((warnings + 1))
            continue
        fi

        if [[ $cmd == !* ]]; then
            target=${cmd#!}
            if [[ -z $target ]]; then
                printf 'line %d: warning: hide directive has no command\n' "$lineno"
                warnings=$((warnings + 1))
            elif [[ -n ${hidden_seen["$target"]:-} ]]; then
                printf 'line %d: warning: duplicate hide directive for %s\n' "$lineno" "$target"
                warnings=$((warnings + 1))
            else
                hidden_seen["$target"]=1
                hide_targets+=("$target")
            fi
            continue
        fi

        if [[ -n ${seen["$cmd"]:-} ]]; then
            printf 'line %d: warning: duplicate command: %s\n' "$lineno" "$cmd"
            warnings=$((warnings + 1))
        fi
        seen["$cmd"]=1
        entries=$((entries + 1))
    done < "$file"

    for target in "${hide_targets[@]}"; do
        if [[ -z ${LABEL["$target"]+x} ]]; then
            printf 'warning: hide directive !%s matches no built-in or config command\n' "$target"
            warnings=$((warnings + 1))
        fi
    done

    printf '%d entries, %d hide directives, %d warning(s)\n' \
        "$entries" "${#hide_targets[@]}" "$warnings"
    (( warnings == 0 ))
}

cmd_preview() {
    local cmd="$*"
    local label=${LABEL["$cmd"]:-$cmd}
    local desc=${DESC["$cmd"]:-}
    local category=${CATEGORY["$cmd"]:-Other}
    local tags=${TAGS["$cmd"]:-}
    local package=${PACKAGE["$cmd"]:-${cmd%% *}}
    local source=${SOURCE["$cmd"]:-built-in}
    local exe=""
    local launches=0 last_used=0 last_label="never"
    local stats
    exe=$(command -v "${cmd%% *}" 2>/dev/null || true)
    stats=$(history_stats "$cmd")
    IFS=$'\t' read -r launches last_used <<< "$stats"
    if (( last_used > 0 )); then
        last_label=$(date -d "@$last_used" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$last_used")
    fi

    if color_enabled; then
        printf '\033[1m%s\033[0m\n' "$label"
    else
        printf '%s\n' "$label"
    fi
    printf '%s\n\n' "$desc"
    printf 'Category : %s\n' "$category"
    if [[ -n $tags ]]; then
        printf 'Tags     : %s\n' "$tags"
    fi
    printf 'Source   : %s\n' "$source"
    printf 'Entry    : %s\n' "$cmd"
    printf 'Launches : %d\n' "$launches"
    printf 'Last used: %s\n' "$last_label"

    if [[ -n $exe ]]; then
        local version=""
        if command -v pacman >/dev/null 2>&1; then
            version=$(pacman -Q "$package" 2>/dev/null || true)
        fi
        printf 'Command  : %s\n' "$exe"
        if [[ -n $version ]]; then
            printf 'Package  : %s\n' "$version"
        else
            printf 'Package  : %s\n' "$package"
        fi
        printf 'Status   : installed\n'
        if [[ -n ${TMUX:-} ]]; then
            printf '\nPress Enter to launch, or C-o for a new tmux window.\n'
        else
            printf '\nPress Enter to launch.\n'
        fi
    else
        printf 'Package  : %s\n' "$package"
        printf 'Status   : not installed\n'
        printf 'Install  : yay -S %s\n' "$package"
        printf '\nThis entry is dimmed. F2 hides/shows missing apps.\n'
    fi
}

cmd_copy() {
    local cmd="$*"
    local copied=0
    if command -v wl-copy >/dev/null 2>&1 && printf '%s' "$cmd" | wl-copy; then
        copied=1
    elif command -v xclip >/dev/null 2>&1 && printf '%s' "$cmd" | xclip -selection clipboard; then
        copied=1
    elif command -v xsel >/dev/null 2>&1 && printf '%s' "$cmd" | xsel --clipboard --input; then
        copied=1
    fi

    if [[ $copied -eq 0 ]]; then
        printf '%s\n' "$cmd" >&2
        notice_write "copy failed: no clipboard tool"
        return 1
    fi
    notice_write "copied: $cmd"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "$APP" "Copied command" "$cmd" || true
    fi
}

cmd_new_window() {
    if [[ -z ${TMUX:-} ]]; then
        printf '%s: not running inside tmux\n' "$APP" >&2
        return 1
    fi
    tmux new-window -c "$PWD" "$*"
}

cmd_launch_kmscon() {
    local tty=${KMSCON_TTY:-tty2}

    if ! is_installed kmscon; then
        if command -v yay >/dev/null 2>&1; then
            sudo yay -S kmscon kmscon-terminfo
        else
            sudo pacman -S kmscon kmscon-terminfo
        fi
        notice_write "kmscon: installed"
    fi

    if [[ ! -f /etc/kmscon/kmscon.conf ]]; then
        sudo mkdir -p /etc/kmscon
        sudo tee /etc/kmscon/kmscon.conf >/dev/null <<'EOF'
font-engine=pango
font-name=Adwaita Mono
font-size=15
hwaccel
backend=drm
EOF
        notice_write "kmscon: config written"
    fi

    if [[ $tty == tty1 ]]; then
        sudo systemctl disable --now "getty@${tty}.service" >/dev/null 2>&1 || true
    fi
    sudo systemctl enable --now "kmsconvt@${tty}.service"

    record_launch kmscon
    state_write "$LAST_STATUS" "kmscon — started on ${tty}"
}

cmd_launch() {
    local cmd="$*"
    local package=${PACKAGE["$cmd"]:-${cmd%% *}}
    local -a argv=()

    case $cmd in
        kmscon)
            cmd_launch_kmscon
            return 0
            ;;
    esac

    if ! is_installed "$cmd"; then
        state_write "$LAST_STATUS" "$cmd — not installed (yay -S $package)"
        return 0
    fi

    record_launch "$cmd"
    read -r -a argv <<< "$cmd"

    local rc=0
    "${argv[@]}" || rc=$?

    state_write "$LAST_STATUS" "$cmd — exit $rc"
    return 0
}

cmd_edit() {
    ensure_config
    local -a editor
    read -r -a editor <<< "${EDITOR:-nano}"
    if ! command -v "${editor[0]}" >/dev/null 2>&1; then
        editor=(nano)
    fi
    "${editor[@]}" "$CONFIG_FILE"
    notice_write "config edited"
}

cmd_toggle_sort() {
    local current next
    current=$(state_read "$SORT_STATE" curated)
    case $current in
        frequent) next=recent ;;
        recent)   next=curated ;;
        *)        next=frequent ;;
    esac
    state_write "$SORT_STATE" "$next"
}

cmd_toggle_missing() {
    local current next
    current=$(state_read "$MISSING_STATE" 1)
    if [[ $current == 1 ]]; then
        next=0
    else
        next=1
    fi
    state_write "$MISSING_STATE" "$next"
}

fallback_menu() {
    local loop=${1:-1}
    local cmd choice label desc category display_label padded
    while true; do
        local -a names=()
        for cmd in "${ORDER[@]}"; do
            if is_installed "$cmd"; then
                names+=("$cmd")
            fi
        done
        if (( ${#names[@]} == 0 )); then
            printf '%s: no installed apps found\n' "$APP" >&2
            return 1
        fi

        printf '%s: fzf not found; choose an app:\n' "$APP" >&2
        local i
        for i in "${!names[@]}"; do
            cmd=${names[$i]}
            label=${LABEL["$cmd"]:-$cmd}
            desc=${DESC["$cmd"]:-No description}
            category=${CATEGORY["$cmd"]:-Other}
            display_label=$label
            if [[ ${cmd,,} != ${label,,} ]]; then
                display_label="$label ($cmd)"
            fi
            printf -v padded '%-24s' "$display_label"
            printf '  %2d) %s %s  [%s]\n' "$((i + 1))" "$padded" "$desc" "$category" >&2
        done
        printf '   q) Quit\n' >&2
        printf 'Selection: ' >&2
        IFS= read -r choice < /dev/tty || return 1

        case $choice in
            q|Q|0) return 0 ;;
        esac
        if ! [[ $choice =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#names[@]} )); then
            printf 'Invalid selection: %s\n' "$choice" >&2
            continue
        fi

        cmd=${names[$((choice - 1))]}
        if [[ $loop -eq 1 ]]; then
            cmd_launch "$cmd"
            continue
        fi
        record_launch "$cmd"
        local -a argv
        read -r -a argv <<< "$cmd"
        exec "${argv[@]}"
    done
}

interactive() {
    local loop=${1:-1}
    if [[ ! -t 0 ]]; then
        printf '%s: interactive mode needs a TTY (use --list, --check, or --help)\n' "$APP" >&2
        return 1
    fi

    ensure_config
    mkdir -p "$CACHE_DIR"

    if ! command -v fzf >/dev/null 2>&1; then
        fallback_menu "$loop"
        return
    fi

    local height="100%"

    local sort_mode show_missing header footer use_ansi=0
    sort_mode=$(state_read "$SORT_STATE" curated)
    show_missing=$(state_read "$MISSING_STATE" 1)
    header=$(header_text)
    footer=$(footer_text)
    if color_enabled; then
        use_ansi=1
    fi

    local -a lines=()
    mapfile -t lines < <(build_lines "$sort_mode" "$show_missing" "$use_ansi")

    local -a args=(
        --delimiter=$'\t'
        --with-nth=2
        --accept-nth=1
        --prompt="Launch TUI > "
        --height="$height"
        --layout=reverse
        --border=rounded
        --border-label=" TUI Apps · by $AUTHOR "
        --info=inline
        --header="$header"
        --footer="$footer"
        --footer-border=line
        --preview="$SELF_Q --_preview {1}"
        --preview-window="right,55%,wrap,border-left,<100(up,55%,wrap,border-left)"
        --bind="ctrl-/:toggle-preview"
        --bind="ctrl-y:execute-silent($SELF_Q --_copy {1})+transform-footer($SELF_Q --_footer)"
        --bind="f1:execute($SELF_Q --_help)"
        --bind="ctrl-e:execute($SELF_Q --_edit)+reload($SELF_Q --_list)+transform-header($SELF_Q --_header)+transform-footer($SELF_Q --_footer)"
        --bind="ctrl-r:execute-silent($SELF_Q --_toggle-sort)+reload($SELF_Q --_list)+transform-footer($SELF_Q --_footer)"
        --bind="f2:execute-silent($SELF_Q --_toggle-missing)+reload($SELF_Q --_list)+transform-footer($SELF_Q --_footer)"
        --bind="f5:reload($SELF_Q --_list)+transform-footer($SELF_Q --_footer)"
        --bind="ctrl-q:abort"
    )
    if [[ $use_ansi -eq 1 ]]; then
        args+=(--ansi)
    fi
    if [[ -n ${TMUX:-} ]]; then
        args+=(--bind="ctrl-o:execute-silent($SELF_Q --_new-window {1})+abort")
    fi
    if [[ $loop -eq 1 ]]; then
        args+=(
            --bind="enter:execute($SELF_Q --_launch {1})+refresh-preview+transform-footer($SELF_Q --_footer)"
        )
        local tool
        for tool in "${!TOOL_HOTKEYS[@]}"; do
            args+=("--bind=${TOOL_HOTKEYS["$tool"]}:execute($SELF_Q --_launch ${tool})+refresh-preview+transform-footer($SELF_Q --_footer)")
        done
    fi

    local selected
    selected=$(printf '%s\n' "${lines[@]}" | fzf "${args[@]}") || exit 0

    if [[ $loop -eq 1 ]]; then
        exit 0
    fi

    [[ -n $selected ]] || exit 0

    local cmd=$selected
    local package=${PACKAGE["$cmd"]:-${cmd%% *}}
    if [[ $cmd == kmscon ]]; then
        cmd_launch_kmscon
        exit 0
    fi
    if ! is_installed "$cmd"; then
        printf '\n%s is not installed. Install it with: yay -S %s\n' "$cmd" "$package" >&2
        IFS= read -r -n 1 -s -p 'Press any key to close...' _ < /dev/tty || true
        printf '\n' >&2
        exit 1
    fi

    record_launch "$cmd"
    local -a argv
    read -r -a argv <<< "$cmd"
    exec "${argv[@]}"
}

usage() {
    cat <<EOF
$APP $VERSION — Developed by $AUTHOR

Usage: $APP [OPTION]

Interactive TUI application launcher.

Options:
  -h, --help          Show this help
  -V, --version       Show version
      --list[=MODE]   List apps (MODE: installed, all)
      --check         Report installed and missing apps
      --check-config  Validate the app list file
      --once          Close the menu after launching an app

Keys:
  Enter   launch the selected app; returns to the menu when it exits
  t       launch the KMSCON console autostart (tty2 by default)
  Esc     quit the menu
  C-q     quit the menu
  C-o     launch in a new tmux window (inside tmux)
  C-y     copy the command to the clipboard
  C-r     cycle curated / most-used / recent ordering
  C-/     toggle the preview pane
  F1      show this help
  F2      show / hide missing apps
  F5      refresh the app list
  C-e     edit the app list

Console autostart:
  kmscon launches through the kmsconvt@ tty systemd unit (default: tty2, override with
  KMSCON_TTY=tty1). Missing packages are installed and the font config is written
  automatically when missing.

Config: $CONFIG_FILE
EOF
}

cmd_internal_help() {
    usage
    if [[ -t 0 || -t 1 || -t 2 ]]; then
        IFS= read -r -n 1 -s -p 'Press any key to return...' _ < /dev/tty || true
        printf '\n' >&2
    fi
}

add_builtins
if [[ -f $CONFIG_FILE ]]; then
    load_config
fi

case ${1:-} in
    "" )               interactive ;;
    --once)            interactive 0 ;;
    -h|--help)         usage ;;
    -V|--version)      printf '%s %s — Developed by %s\n' "$APP" "$VERSION" "$AUTHOR" ;;
    --list)            shift; cmd_list "${1:-installed}" ;;
    --list=*)          cmd_list "${1#*=}" ;;
    --check)           cmd_check ;;
    --check-config)    cmd_check_config ;;
    --_list)           cmd_internal_list ;;
    --_list=*)         cmd_internal_list "${1#*=}" ;;
    --_preview)        shift; cmd_preview "$@" ;;
    --_copy)           shift; cmd_copy "$@" ;;
    --_new-window)     shift; cmd_new_window "$@" ;;
    --_launch)         shift; cmd_launch "$@" ;;
    --_edit)           cmd_edit ;;
    --_toggle-sort)    cmd_toggle_sort ;;
    --_toggle-missing) cmd_toggle_missing ;;
    --_header)         header_text ;;
    --_footer)         footer_text ;;
    --_help)           cmd_internal_help ;;
    *)
        printf '%s: unknown option: %s\n' "$APP" "$1" >&2
        usage >&2
        exit 2
        ;;
esac
